# ---------------------------------------------------------------------------
# Copy to .env and fill in. Every variable here is required — the app refuses
# to boot without them (see src/lib/env.ts).
# ---------------------------------------------------------------------------

# Postgres. The local docker compose file serves exactly this.
DATABASE_URL="postgres://postgres:postgres@localhost:5432/postgres"

# Session signing key. Generate your own:
#   openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-32-or-more-random-characters"

# Public URL of the app. In production use the real https origin,
# e.g. https://mentorship.example.com
BETTER_AUTH_URL="http://localhost:3000"

# Where the browser calls the tRPC API. Normally the same as BETTER_AUTH_URL.
# Optional on Vercel, which infers it.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Discord — https://discord.com/developers/applications
#
# OAuth2 redirect URL must be:
#   <BETTER_AUTH_URL>/api/auth/callback/discord
#
# The bot needs Manage Roles + Manage Channels, must be a member of your
# server, and its role must sit ABOVE the roles it creates.
# ---------------------------------------------------------------------------
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_BOT_TOKEN=""

# ---------------------------------------------------------------------------
# Not set here: the Discord server itself. An admin picks it once at
# /admin/settings and it is stored in the database, so one deployment can be
# repointed without a redeploy.
# ---------------------------------------------------------------------------
