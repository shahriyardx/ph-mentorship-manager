// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  user
  admin
  mentor
  superadmin
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  student Student?
  mentors Mentor[]

  appliedForMentor Boolean @default(false)

  role UserRole @default(user)

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Batch {
  id   String @id @default(cuid())
  name String

  /// Overrides Settings.serverId for this batch. Null = use the default.
  discordServerId String?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  students Student[]
  mentors  Mentor[]
  isCurrent     Boolean        @default(false)

  @@map("batch")
}

model Mentor {
  id String @id @default(cuid())

  batchId               String?
  categoryId            String?
  announcementChannelId String?
  discussionChannelId   String?
  helpChannelId         String?
  resourceChannelId     String?

  /// Discord role given to this instructor's students.
  roleId       String?
  /// Discord role given to the instructor themselves.
  mentorRoleId String?

  batch  Batch? @relation(fields: [batchId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  discordChannelId String
  students Student[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One record per instructor per batch, so a mentor can run several cohorts
  /// at once and each keeps its own students and channels.
  @@unique([userId, batchId])
  @@index([userId])
  @@map("mentor")
}

/// One row per student per batch, covering the whole lifecycle:
///   imported        -> row exists
///   assigned        -> mentorId is set
///   joined          -> userId is set (only written once Discord succeeded)
model Student {
  id    String @id @default(cuid())
  name  String @default("")
  email String
  phone String @default("")

  batchId String
  batch   Batch  @relation(fields: [batchId], references: [id], onDelete: Cascade)

  /// Null until an admin assigns them to an instructor.
  mentorId String?
  mentor   Mentor? @relation(fields: [mentorId], references: [id], onDelete: SetNull)

  /// Null until the student signs in and claims this email.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  joinedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, batchId])
  @@index([batchId])
  @@index([mentorId])
  @@map("student")
}

model Settings {
  id                    String  @id @default(cuid())
  currentBatchId        String  @default("")
  serverId              String  @default("")
  dashboardLogChannelId String  @default("")
  maintenanceMode       Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}
